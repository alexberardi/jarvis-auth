AUTH_SECRET_KEY="change-this"
AUTH_ALGORITHM="HS256"
# base64 PKCS#8 PEM; generated by `./jarvis init`. Empty = stay on HS256.
AUTH_PRIVATE_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="14"
DATABASE_URL="postgresql+psycopg2://devuser:devpassword@host.docker.internal:5432/jarvis_auth"
JARVIS_AUTH_PORT="7701"
